# Safe defaults, committed. Override locally in .env.local (gitignored).

APP_DEBUG=false
APP_PROJECT_NAME=lexicon-routing
APP_VERSION=0.1.0

# NEOS Server for Concorde; set NEOS_EMAIL in .env.local
NEOS_URL=https://neos-server.org:3333
NEOS_EMAIL=
NEOS_TIMEOUT_S=1800
NEOS_INPUT_TYPE=tsplib
NEOS_ALGORITHM=cplex

# Google Gemini API, alternative extractor; set GEMINI_API_KEY in .env.local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=120
GEMINI_THINKING_BUDGET=0

LOG_LEVEL=INFO
